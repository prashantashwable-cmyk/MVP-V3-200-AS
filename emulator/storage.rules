rules_version = '2';
// EMULATOR-ONLY placeholder (DECISIONS D-19). Not deployed anywhere: it is referenced
// only by firebase.emulator.json. Real Storage rules are designed in Step 11.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
