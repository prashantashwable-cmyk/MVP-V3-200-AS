rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role != null ? request.auth.token.role : 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : 'customer');
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'admin' || request.auth.token.email == 'prashantashwable@gmail.com');
    }

    function isTechnician() {
      return isAuthenticated() && (getUserRole() == 'technician' || getUserRole() == 'qc_inspector' || isAdmin());
    }

    function isSurveyor() {
      return isAuthenticated() && (getUserRole() == 'surveyor' || isAdmin());
    }

    function isCustomer() {
      return isAuthenticated();
    }

    function isOwnerEmail() {
      return isAuthenticated() && request.auth.token.email == 'prashantashwable@gmail.com';
    }

    // ---- MVP (Step 03, plan §3) helpers --------------------------------
    // Roles come from users/{uid}.role, set only by the Admin or an invite.
    function hasProfile() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasRole(role) {
      return hasProfile() && profile().role == role;
    }
    function isOwnerRole() {
      return hasRole('owner');
    }
    // Admin or Owner: may read every order (Owner is read-only).
    function isStaffReader() {
      return isAdmin() || isOwnerRole();
    }
    function myCustomerId() {
      return hasProfile() ? profile().get('customerId', '') : '';
    }
    function orderData(orderId) {
      return get(/databases/$(database)/documents/projects/$(orderId)).data;
    }
    // A user with an open task on the order (or the sales owner), directly or through a role pool.
    function isOrderParticipant(orderId) {
      return hasProfile() && (
        request.auth.uid in orderData(orderId).get('participantIds', []) ||
        ('role:' + profile().role) in orderData(orderId).get('participantIds', [])
      );
    }
    // The order's own customer login (linked by invite, D-13).
    function isOrderCustomer(orderId) {
      return hasRole('customer') && myCustomerId() != '' && orderData(orderId).customerId == myCustomerId();
    }
    function canReadOrder(orderId) {
      return isStaffReader() || isOrderParticipant(orderId) || isOrderCustomer(orderId);
    }
    function canWriteOrder(orderId) {
      return isAdmin() || isOrderParticipant(orderId) || isOrderCustomer(orderId);
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // 1. Users collection
    // Users can read their own profile; only Admins can create/modify arbitrary user roles.
    //
    // Phase 05 fix (real, previously-live privilege-escalation hole):
    // the prior blanket `allow write: if ... request.auth.uid == userId`
    // let ANY authenticated user set THEIR OWN `role` field to 'admin'
    // (or any other role) via a direct Firestore write, bypassing the
    // owner-email-only admin logic that existed only in client JS
    // (src/lib/firestoreUsers.ts) — exactly the "client-side authorization
    // is not enforcement" gap non-negotiable principle #8 warns about.
    // Fixed by: (a) a new document may only self-claim role 'admin' if
    // the token's email is the designated owner email — matching the
    // existing client-side intent, now actually enforced; (b) an
    // existing document's `role`/`status` can only be changed by an
    // Admin, never by the user themself.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // MVP Step 03 (audit F-2, narrowing): a new user may self-create only
      // as 'pending_selection', or with exactly the role (and customer
      // link) the Admin put on their invite. No self-claimed staff roles.
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        isOwnerEmail() ||
        request.resource.data.role == 'pending_selection' ||
        (request.auth.token.email != null &&
          // Phase 05 guard kept: no one becomes admin by signing up (only the owner email, or an Admin edit).
          request.resource.data.role != 'admin' &&
          exists(/databases/$(database)/documents/user_invites/$(request.auth.token.email.lower())) &&
          get(/databases/$(database)/documents/user_invites/$(request.auth.token.email.lower())).data.role == request.resource.data.role &&
          get(/databases/$(database)/documents/user_invites/$(request.auth.token.email.lower())).data.get('customerId', '') == request.resource.data.get('customerId', ''))
      );

      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.get('customerId', '') == resource.data.get('customerId', '')
      );

      allow delete: if isAdmin();
    }

    // 1b. Leads (sales pipeline captured by surveyors, managed by admins)
    match /leads/{leadId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.surveyorId == request.auth.uid
      );
      allow create: if isAuthenticated() && (isAdmin() || isSurveyor());
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.surveyorId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // 2. Elevator Contracts
    // Customers can ONLY read their own elevator contracts; Admins have full access.
    match /contracts/{contractId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.customerId == request.auth.uid ||
        resource.data.customerEmail == request.auth.token.email
      );
      allow create, update, delete: if isAdmin();
    }

    // 3. Site SOPs, Safety Checklists & QC Inspections
    // Technicians & QC Inspectors can access SOPs assigned to them; Admins have full audit access.
    match /site_sops/{sopId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.assignedTechnicianId == request.auth.uid ||
        resource.data.assignedTechnicianEmail == request.auth.token.email
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.assignedTechnicianId == request.auth.uid
      );
      allow create, delete: if isAdmin();
    }

    // 4. Breakdown Alerts & 24/7 SOS
    // Customers can report breakdowns for their site; Technicians can read/update assigned alerts; Admins oversee all.
    match /breakdown_sos/{alertId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.reportedByUserId == request.auth.uid ||
        resource.data.assignedTechnicianId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.assignedTechnicianId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // 5. Audit Logs Master
    // STRICT: Master audit logs are read-only to Admin for enterprise compliance.
    match /audit_logs/{logId} {
      allow read: if isStaffReader(); // MVP: + Owner (read-only)
      allow create: if isAuthenticated(); // Application server/client logs audit trail
      allow update, delete: if false;     // Immutable audit trail
    }

    // 6. Help KB & FAQs
    // Publicly readable by all authenticated users; writable only by Admin
    match /help_articles/{articleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 7. Phase 04 — canonical project-spine collections (Customer, Site,
    // Project, Quote, QuoteVersion, Contract, PaymentSchedule, Payment).
    // See src/domain/entities.ts for the shapes and src/repository/ for
    // the code that writes them.
    //
    // These rules are intentionally conservative pending Phase 05's full
    // permission model: Admin has full access everywhere; the creating/
    // owning internal user (surveyor/sales on Customer/Site/Project/Quote)
    // can read and update their own records. Direct customer/supplier
    // self-service access is deferred to Phase 05, which introduces the
    // permission model and the Customer<->Firebase-Auth-uid link needed
    // to scope it safely rather than guessing at an ownership check here
    // that could be wrong in either direction (too open or too closed).
    // Until Phase 05 lands, customer/supplier roles get NO direct access
    // to these collections — safer than a guessed-wrong rule, and not a
    // regression since none of these collections existed before this
    // phase.
    function isRecordOwner(field) {
      return isAuthenticated() && resource.data[field] == request.auth.uid;
    }

    match /customers/{customerId} {
      // MVP: + Owner, the customer's own login, and the order's participants; sales may create on qualification.
      allow read: if isAdmin() || isSurveyor() || isOwnerRole() ||
        (isAuthenticated() && myCustomerId() == customerId) ||
        (resource.data.get('orderId', '') != '' && isOrderParticipant(resource.data.orderId));
      allow create: if isAdmin() || isSurveyor() || hasRole('sales');
      allow update: if isAdmin() || isSurveyor();
      allow delete: if isAdmin();
    }

    match /sites/{siteId} {
      allow read: if isAdmin() || isSurveyor() || isOwnerRole() ||
        (isAuthenticated() && myCustomerId() != '' && resource.data.customerId == myCustomerId()) ||
        (resource.data.get('orderId', '') != '' && isOrderParticipant(resource.data.orderId));
      allow create: if isAdmin() || isSurveyor() || hasRole('sales');
      allow update: if isAdmin() || isSurveyor();
      allow delete: if isAdmin();
    }

    match /projects/{projectId} {
      // MVP: + Owner, participants (array-contains queries) and the order's own customer (customerId queries).
      allow read: if isAdmin() || isRecordOwner('ownerUserId') || isOwnerRole() ||
        (hasProfile() && (request.auth.uid in resource.data.get('participantIds', []) ||
                          ('role:' + profile().role) in resource.data.get('participantIds', []))) ||
        (hasRole('customer') && myCustomerId() != '' && resource.data.customerId == myCustomerId());
      allow create: if isAuthenticated() && (isAdmin() || isSurveyor() || hasRole('sales'));
      // Participants and the customer move the order through the rules (D-08),
      // but can never cancel or complete it, nor touch any other field.
      allow update: if isAdmin() || isRecordOwner('ownerUserId') || (
        (isOrderParticipant(projectId) || isOrderCustomer(projectId)) &&
        onlyChanges(['stage', 'status', 'participantIds', 'holdReason', 'holdReviewDate', 'lift', 'updatedAt', 'updatedBy', 'version']) &&
        request.resource.data.get('status', 'ACTIVE') in ['ACTIVE', 'ON_HOLD']
      );
      allow delete: if isAdmin();
    }

    match /quotes/{quoteId} {
      allow read: if isAdmin() || isRecordOwner('createdBy');
      allow create: if isAuthenticated() && (isAdmin() || isSurveyor());
      allow update: if isAdmin() || isRecordOwner('createdBy');
      allow delete: if isAdmin();
    }

    match /quote_versions/{quoteVersionId} {
      // Append-only per the domain model (src/domain/entities.ts):
      // no update/delete once created.
      allow read: if isAdmin() || isRecordOwner('createdBy');
      allow create: if isAuthenticated() && (isAdmin() || isSurveyor());
      allow update, delete: if false;
    }

    // `contracts_v2`: the canonical Contract entity (Phase 02). Distinct
    // from the pre-existing `contracts` collection above, which has a
    // different shape (see src/repository/entities.ts comment) — kept
    // separate deliberately so this new rule can never be misread as
    // governing the old collection or vice versa.
    match /contracts_v2/{contractId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false; // contracts are void'd via status, never deleted
    }

    match /payment_schedules/{scheduleId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || isRecordOwner('createdBy');
      // Phase 35 fix (real Phase 34 finding): previously bare
      // `isAuthenticated()` let ANY signed-in user create a Payment
      // document self-claiming ANY `createdBy` value — impersonating a
      // different user's payment record. Now the created document must
      // self-attest the real acting user's uid (or be created by an
      // Admin on someone else's behalf), matching the same `createdBy`
      // field the read rule above already trusts. Does not (yet) verify
      // the referenced `projectId` is one this user actually owns — a
      // deeper, cross-document check flagged as remaining, real,
      // documented scope in docs/security/LEGACY-AUTHORIZATION-REMEDIATION.md
      // rather than guessed at without live verification.
      allow create: if isAdmin() ||
        (isAuthenticated() && request.resource.data.createdBy == request.auth.uid);
      // Payments are never edited in place once confirmed — status moves
      // forward via new fields, not arbitrary field overwrite, and only
      // Admin (finance role arrives with full RBAC in Phase 05) can post
      // those transitions.
      allow update: if isAdmin();
      allow delete: if false; // immutable financial record
    }

    // 8. Phase 06 — audit trail and idempotency store.
    // `audit_logs` already existed (Phase 01 §5) with exactly this
    // shape of rule; unchanged here. `idempotency_keys` is new: it
    // backs src/lib/idempotency.ts's runIdempotent() and must be
    // exactly as immutable as an audit log, for the same reason — an
    // idempotency record that could be edited or deleted defeats its
    // own purpose (a retried payment/PO/webhook could "forget" it
    // already ran).
    match /purchase_orders/{poId} {
      allow read: if isAdmin() || isRecordOwner('createdBy');
      allow create: if isAuthenticated() && isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /idempotency_keys/{keyId} {
      // MVP: the transactional claim must read the record; MVP results are only record ids.
      allow read: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.opType.matches('mvp[.].*')));
      allow create: if isAuthenticated(); // any authenticated write path may register a dedup record
      // Phase 37 fix: a real, more fundamental bug found while building
      // the transactional-idempotency concurrency tests — `allow update:
      // if false` blocked EVERY completion write, meaning
      // src/lib/idempotency.ts's documented CLAIM -> COMPLETE lifecycle
      // could never actually reach 'completed' against real Firestore
      // rules; every real production idempotency-guarded operation would
      // have failed its own completion step. Scoped narrowly, not thrown
      // open: exactly two transitions are allowed on THIS SAME record —
      // (a) pending -> completed/failed (the real CLAIM -> COMPLETE/FAIL
      // lifecycle) and (b) failed -> pending (a fresh retry reclaiming a
      // record whose prior attempt genuinely failed, `src/lib/idempotency.ts`'s
      // `isReclaimable()`). The identity fields (idempotencyKey/opType)
      // can never be rewritten in either case — a completed record can
      // never be reopened, and no one can claim a DIFFERENT key/opType by
      // overwriting an existing document id.
      allow update: if isAuthenticated() &&
        request.resource.data.idempotencyKey == resource.data.idempotencyKey &&
        request.resource.data.opType == resource.data.opType && (
          (resource.data.status == 'pending' &&
            (request.resource.data.status == 'completed' || request.resource.data.status == 'failed')) ||
          (resource.data.status == 'failed' && request.resource.data.status == 'pending')
        );
      allow delete: if false; // still immutable — never deleted, only transitioned
    }

    // 9. Phase 07 — event bus / workflow execution engine
    // (src/events/bus.ts) and the entities its two worked-example
    // handlers (QUOTE_ACCEPTED, QC_FAILED) create.
    match /workflow_instances/{instanceId} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    match /workflow_executions/{executionId} {
      // Every execution attempt, including dead-letters, is part of the
      // audit trail for automation — immutable once written, same as
      // audit_logs/idempotency_keys.
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /snags/{snagId} {
      allow read: if isAdmin() || isRecordOwner('assignedTo');
      allow create: if isAuthenticated();
      allow update: if isAdmin() || isRecordOwner('assignedTo');
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || isRecordOwner('audienceUserId') || (hasProfile() && (
        resource.data.audienceUserId == 'role:' + profile().role ||
        resource.data.audienceUserId == 'customer:' + myCustomerId()));
      allow create: if isAuthenticated();
      allow update: if isAdmin() || ((isRecordOwner('audienceUserId') || (hasProfile() && (
        resource.data.audienceUserId == 'role:' + profile().role ||
        resource.data.audienceUserId == 'customer:' + myCustomerId()))) && onlyChanges(['read']));
      allow delete: if false;
    }

    match /handovers/{handoverId} {
      // Admin-only write: Handover.qcPassed is the hard gate Phase 09
      // relies on, and it must never be settable by anyone other than
      // the automation engine / an admin action — not by a technician
      // or customer request, however indirectly.
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /qc_inspections/{inspectionId} {
      allow read: if isAdmin() || isRecordOwner('inspectorId');
      // Phase 35 fix (real Phase 34 finding): previously bare
      // `isAuthenticated()` let ANY signed-in user (including a customer
      // session) create a QC inspection record for ANY project — a
      // quality-gate-integrity concern, since Handover.qcPassed (the
      // Phase 09 hard gate) derives from this collection via the event
      // bus. Deliberately uses `isTechnician()` (admin + technician +
      // qc_inspector) rather than a strict `inspectorId == request.auth.uid`
      // self-match: the real QC-assignment flow
      // (QcInspectorAssignmentScreen -> requestQC()) lets one technician/
      // admin assign a DIFFERENT technician as the inspector, which a
      // strict self-match would have broken with no way to verify against
      // a live emulator. This still closes the real gap found (customer/
      // supplier sessions can no longer create QC records at all) without
      // risking a regression on the legitimate assignment-by-a-peer path.
      allow create: if isTechnician();
      allow update: if isAdmin() || isRecordOwner('inspectorId');
      allow delete: if false;
    }

    // 10. Phase 09 — delivery, installation, and warranty entities.
    match /shipments/{shipmentId} {
      allow read: if isAdmin() || isTechnician();
      allow create, update: if isAdmin() || isTechnician();
      allow delete: if false;
    }

    match /delivery_receipts/{receiptId} {
      allow read: if isAdmin() || isRecordOwner('receivedBy');
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if false; // a receipt is a point-in-time record; corrections happen via a new record, not an edit
    }

    match /installation_jobs/{jobId} {
      allow read: if isAdmin() || isRecordOwner('technicianId');
      allow create: if isAdmin();
      allow update: if isAdmin() || isRecordOwner('technicianId');
      allow delete: if false;
    }

    match /warranties/{warrantyId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // 11. Phase 11 — media/document metadata and reconciliation records.
    // Actual media BYTES are not stored in Firestore (Storage rules
    // would govern those, in a real deployment with a bucket
    // configured — see src/offline/mediaUpload.ts's documented gap);
    // this collection is document METADATA only, written after a
    // confirmed upload.
    match /documents/{documentId} {
      allow read: if isAdmin() || isRecordOwner('uploadedBy');
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if false; // versioning, not deletion, per the domain model
    }

    match /reconciliation_records/{recordId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // 12. Phase 12 — observability events (src/lib/observability.ts).
    // Any authenticated session may report a client crash / app error
    // about itself (that's the whole point — a crashed session still
    // needs to be able to report the crash); only Admin can read the
    // resulting stream. Immutable once written, same as every other
    // audit-shaped collection in this file.
    match /observability_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
      // =====================================================================
    // MVP collections (Step 03, plan §2–§3). Every order-scoped record
    // carries orderId + customerId and is readable by Admin/Owner, the
    // order's participants and the order's own customer. Writes mirror
    // the order service; cost (quote_costs) is Admin/Owner only (I-5).
    // =====================================================================
    match /tasks/{taskId} {
      allow read: if isStaffReader() ||
        resource.data.assigneeId == request.auth.uid ||
        (hasProfile() && resource.data.assigneeId == 'role:' + profile().role) ||
        (hasProfile() && myCustomerId() != '' && resource.data.assigneeId == 'customer:' + myCustomerId()) ||
        (resource.data.orderId != '' && canReadOrder(resource.data.orderId));
      allow create: if isAdmin() ||
        (request.resource.data.orderId == '' && hasRole('sales')) ||
        (request.resource.data.orderId != '' && canWriteOrder(request.resource.data.orderId));
      allow update: if isAdmin() || (
        (resource.data.assigneeId == request.auth.uid ||
         (resource.data.orderId != '' && canWriteOrder(resource.data.orderId))) &&
        onlyChanges(['status', 'previousStatus', 'completedAt', 'notes', 'evidence', 'updatedAt', 'version', 'startedAt', 'checkedInAt'])
      );
      allow delete: if false;
    }

    match /blockers/{blockerId} {
      allow read: if canReadOrder(resource.data.orderId);
      allow create: if canWriteOrder(request.resource.data.orderId) && request.resource.data.status == 'OPEN';
      allow update: if isAdmin() || (canWriteOrder(resource.data.orderId) &&
        onlyChanges(['status', 'resolutionNote', 'resolvedAt', 'updatedAt', 'version']));
      allow delete: if false;
    }

    match /canonical_leads/{leadId} {
      allow read: if isStaffReader() || resource.data.salesOwnerId == request.auth.uid ||
        (resource.data.get('orderId', '') != '' && canReadOrder(resource.data.orderId));
      allow create: if isAdmin() || (hasRole('sales') && request.resource.data.salesOwnerId == request.auth.uid);
      allow update: if isAdmin() || (resource.data.salesOwnerId == request.auth.uid &&
        request.resource.data.salesOwnerId == resource.data.salesOwnerId) ||
        // D-04: the lead's status follows its order, whoever moves the order.
        (resource.data.get('orderId', '') != '' && canWriteOrder(resource.data.orderId) &&
          onlyChanges(['mvpStatus', 'stage', 'lostReason', 'updatedAt', 'version']));
      allow delete: if false;
    }

    match /surveys/{surveyId} {
      allow read: if canReadOrder(resource.data.orderId);
      allow create: if isAdmin() || (hasRole('surveyor') && isOrderParticipant(request.resource.data.orderId));
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /order_quotes/{quoteId} {
      allow read: if canReadOrder(resource.data.orderId);
      allow create: if isAdmin();
      // The customer may only accept or reject a SENT quote.
      allow update: if isAdmin() || (isOrderCustomer(resource.data.orderId) && resource.data.status == 'SENT' &&
        request.resource.data.status in ['ACCEPTED', 'REJECTED'] &&
        onlyChanges(['status', 'decidedAt', 'decidedBy', 'updatedAt', 'version']));
      allow delete: if false;
    }

    match /quote_costs/{quoteId} {
      allow read: if isStaffReader();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /payment_milestones/{milestoneId} {
      allow read: if canReadOrder(resource.data.orderId);
      // Milestones are created PENDING and unpaid (on acceptance, by the customer or Admin).
      allow create: if isAdmin() || (canWriteOrder(request.resource.data.orderId) &&
        request.resource.data.status == 'PENDING' && request.resource.data.amountPaid == 0);
      // Only the Admin verifies money; the customer only submits proof.
      allow update: if isAdmin() || (isOrderCustomer(resource.data.orderId) &&
        onlyChanges(['reference', 'method', 'proofNote', 'submittedAt', 'submittedBy', 'updatedAt', 'version'])) ||
        // The rules set a milestone's due date when its collect task is created (e.g. QC PASS → final payment).
        (isOrderParticipant(resource.data.orderId) && onlyChanges(['dueDate', 'updatedAt', 'version']));
      allow delete: if false;
    }

    match /suppliers/{supplierId} {
      allow read: if isStaffReader();
      allow write: if isAdmin();
    }

    match /install_checklists/{orderId} {
      allow read: if canReadOrder(resource.data.orderId);
      allow create: if isAdmin();
      allow update: if isAdmin() || (isOrderParticipant(resource.data.orderId) && onlyChanges(['items', 'updatedAt', 'version']));
      allow delete: if false;
    }

    match /qc_records/{recordId} {
      allow read: if canReadOrder(resource.data.orderId);
      allow create: if isAdmin() || (hasRole('qc') && isOrderParticipant(request.resource.data.orderId) &&
        request.resource.data.inspectorId == request.auth.uid);
      allow update, delete: if false;
    }

    match /order_handovers/{orderId} {
      allow read: if canReadOrder(resource.data.orderId);
      allow create: if isAdmin() || (isOrderCustomer(request.resource.data.orderId) && request.resource.data.get('completedAt', null) == null);
      allow update: if isAdmin() || (isOrderCustomer(resource.data.orderId) &&
        onlyChanges(['customerApprovedAt', 'customerApprovedBy', 'updatedAt', 'version']));
      allow delete: if false;
    }

    match /amcs/{orderId} {
      allow read: if canReadOrder(resource.data.orderId);
      allow write: if isAdmin();
    }

    match /compliance_docs/{docId} {
      allow read: if canReadOrder(resource.data.orderId);
      allow write: if isAdmin();
    }

    match /service_cases/{caseId} {
      allow read: if canReadOrder(resource.data.orderId) || resource.data.assigneeId == request.auth.uid;
      allow create: if isAdmin() || (isOrderCustomer(request.resource.data.orderId) && request.resource.data.status == 'OPEN');
      allow update: if isAdmin() || (resource.data.assigneeId == request.auth.uid &&
        onlyChanges(['status', 'acknowledgedAt', 'resolvedAt', 'resolutionNote', 'photo', 'updatedAt', 'version']));
      allow delete: if false;
    }

    match /approval_requests/{requestId} {
      allow read: if isStaffReader();
      allow write: if isAdmin();
    }

    match /mvp_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Order-code counter (D-02): may only ever move forward by one.
    match /counters/{counterId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || hasRole('sales');
      allow update: if (isAdmin() || hasRole('sales')) && request.resource.data.next == resource.data.next + 1;
      allow delete: if false;
    }

    // D-13: Admin-issued invites; the invited person may read their own.
    match /user_invites/{email} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.email != null && request.auth.token.email.lower() == email);
      allow write: if isAdmin();
    }
  }
}
